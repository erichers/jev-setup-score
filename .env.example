# Copy to .env if you want to export these yourself.
# The API reads environment variables and appsettings.json.
# Do not put real secrets here. The root/root pair below is a local example only.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Zero-config default. Leave Provider as Sqlite and `dotnet run` uses a local file.
Database__Provider=Sqlite
# Used only when the server cannot be reached for AutoDetect. MAMP ships MySQL 5.7.39.
Database__MySqlVersion=5.7.39-mysql
ConnectionStrings__Default=Data Source=jev.db

# Public site prefix for links the API writes (PDF URL, Swagger).
# Leave empty for relative api/... links, which follow the Angular base href.
PublicBaseUrl=http://localhost:8888/grokbot/asp/jev-setup-score
# Set only when the reverse proxy forwards this prefix to Kestrel.
PathBase=

# MAMP MySQL example. Set Database__Provider=MySql to use it.
# Create the database first: CREATE DATABASE jev_setup_score CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Host 127.0.0.1, port 8889, user root, password root.
ConnectionStrings__MySql=Server=127.0.0.1;Port=8889;Database=jev_setup_score;User=root;Password=root;CharSet=utf8mb4;SslMode=None

# Docker Compose reads MYSQL_ROOT_PASSWORD. The default in compose is root.
MYSQL_ROOT_PASSWORD=root

Data__CacheDirectory=
Data__AllowLiveFetch=true
Data__YahooBaseUrl=https://query1.finance.yahoo.com/v8/finance/chart/
Data__StooqBaseUrl=https://stooq.com/q/d/l/
Data__HttpTimeoutSeconds=8
Cors__Origins__0=http://localhost:4200
Cors__Origins__1=http://localhost:8888
